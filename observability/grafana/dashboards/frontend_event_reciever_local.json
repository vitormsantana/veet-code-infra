{
  "uid": "frontend_event_reciever-local",
  "title": "Analytics: Frontend Event Receiver (Local)",
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "tags": [
    "observability",
    "local",
    "cognito_dynamo"
  ],
  "panels": [
    {
      "type": "text",
      "title": "How To Use",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "This dashboard shows metrics for Prometheus job `frontend_event_reciever_local`.\n\nTo generate data: run the local adapter for this lambda and make requests from the frontend with `VEET_LOCAL_OBS=1`.\n\nTraces: copy `X-Local-Trace-Id` from the browser console, then Grafana Explore -> Tempo -> Import trace."
      }
    },
    {
      "type": "timeseries",
      "title": "RPS (total, 1m)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(invocations_total{job=\"frontend_event_reciever_local\"}[1m]))",
          "legendFormat": "rps"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RPS (by Result, 1m)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(invocations_total{job=\"frontend_event_reciever_local\"}[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate (% of requests, 1m)",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(invocations_total{job=\"frontend_event_reciever_local\",result=\"error\"}[1m])) / clamp_min(sum(rate(invocations_total{job=\"frontend_event_reciever_local\"}[1m])), 0.000001))",
          "legendFormat": "error_%"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Avg Latency (ms, 1m window)",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(latency_ms_sum{job=\"frontend_event_reciever_local\"}[1m])) / clamp_min(sum(rate(latency_ms_count{job=\"frontend_event_reciever_local\"}[1m])), 0.000001)",
          "legendFormat": "avg_latency_ms"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DynamoDB Fetch: Last Latency (ms)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "max(dynamodb_fetch_latency_ms_last{job=\"frontend_event_reciever_local\",result=\"success\"})",
          "legendFormat": "last_db_ms"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DynamoDB Put: Last Latency (ms)",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "max(dynamodb_put_latency_ms_last{job=\"frontend_event_reciever_local\",result=\"success\"})",
          "legendFormat": "last_put_ms"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Items Fetched: Last",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "max(dynamodb_items_fetched_last{job=\"frontend_event_reciever_local\"})",
          "legendFormat": "items_last"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "OpenAI: Last Latency (ms)",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "max(openai_latency_ms_last{job=\"frontend_event_reciever_local\",result=\"success\"})",
          "legendFormat": "openai_last_ms"
        }
      ]
    }
  ]
}