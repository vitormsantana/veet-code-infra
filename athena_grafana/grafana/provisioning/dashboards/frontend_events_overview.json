          "rawSQL": "SELECT\n  apiname,\n  CAST(sum(CASE WHEN apioutcome = 'success' THEN 1 ELSE 0 END) AS DOUBLE) AS success,\n  CAST(sum(CASE WHEN apioutcome <> 'success' OR apioutcome IS NULL THEN 1 ELSE 0 END) AS DOUBLE) AS error\nFROM frontend_events.analytics_events\nWHERE eventtype = 'api_call'\nGROUP BY apiname\nORDER BY (\n  sum(CASE WHEN apioutcome = 'success' THEN 1 ELSE 0 END) +\n  sum(CASE WHEN apioutcome <> 'success' OR apioutcome IS NULL THEN 1 ELSE 0 END)\n) DESC\nLIMIT 15;",
