      "targets": [
        {
          "connectionArgs": {
            "region": "sa-east-1",
            "catalog": "AwsDataCatalog",
            "database": "frontend_events",
            "workgroup": "primary"
          },
          "rawSQL": "WITH events AS (\n  SELECT\n    coalesce(\n      try(from_iso8601_timestamp(eventtimestamp)),\n      try(from_iso8601_timestamp(ingestiontimestamp))\n    ) AS ts,\n    eventtype,\n    apiname,\n    apiendpoint,\n    apimethod,\n    apistatuscode,\n    apioutcome\n  FROM frontend_events.analytics_events\n), daily AS (\n  SELECT\n    date_trunc('day', ts) AS time,\n    sum(CASE WHEN eventtype = 'button_click' THEN 1 ELSE 0 END) AS total_clicks,\n    sum(CASE WHEN eventtype = 'button_click' AND (\n      apiname IS NOT NULL OR\n      apiendpoint IS NOT NULL OR\n      apimethod IS NOT NULL OR\n      apistatuscode IS NOT NULL OR\n      apioutcome IS NOT NULL\n    ) THEN 1 ELSE 0 END) AS invalid_clicks\n  FROM events\n  WHERE ts IS NOT NULL\n  GROUP BY 1\n)\nSELECT\n  time,\n  CAST(invalid_clicks AS DOUBLE) AS invalid_clicks,\n  CAST(CASE\n    WHEN total_clicks = 0 THEN 0.0\n    ELSE (invalid_clicks * 100.0) / total_clicks\n  END AS DOUBLE) AS invalid_rate_pct\nFROM daily\nORDER BY time;",
          "refId": "A"
        }
