          "rawSQL": "WITH events AS (\n  SELECT\n    coalesce(\n      try(from_iso8601_timestamp(eventtimestamp)),\n      try(from_iso8601_timestamp(ingestiontimestamp))\n    ) AS ts,\n    page\n  FROM frontend_events.analytics_events\n  WHERE eventtype = 'page_access'\n    AND page IS NOT NULL\n    AND length(trim(page)) > 0\n)\nSELECT\n  page,\n  CAST(count(*) AS DOUBLE) AS total\nFROM events\nWHERE ts IS NOT NULL\n  AND ts BETWEEN from_unixtime($__from/1000) AND from_unixtime($__to/1000)\nGROUP BY page\nORDER BY total DESC\nLIMIT 20;",
